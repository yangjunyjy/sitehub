{
  "name": "sitehub-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "admin",
    "site"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev:admin": "npm run dev -w @sitehub/admin",
    "dev:site": "npm run dev -w @sitehub/site",
    "build": "npm run build --workspaces",
    "start:admin": "npm start -w @sitehub/admin",
    "start:site": "npm start -w @sitehub/site",
    "test": "node --test server/*.test.mjs shared/*.test.mjs && npm test --workspaces",
    "test:browser": "node tests/native-browser.mjs"
  },
  "dependencies": {
    "sirv": "^3.0.2",
    "json-bigint": "^1.0.0"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
