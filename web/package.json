{
  "name": "sitehub-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "admin",
    "product",
    "gateway-admin",
    "blog"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev:admin": "npm run dev -w @sitehub/admin",
    "dev:product": "npm run dev -w @sitehub/product",
    "dev:blog": "npm run dev -w @sitehub/blog",
    "start:admin": "npm run start -w @sitehub/admin",
    "start:product": "npm run start -w @sitehub/product",
    "start:blog": "npm run start -w @sitehub/blog",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "test:browser": "node tests/native-browser.mjs",
    "test:captcha": "node tests/captcha-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
