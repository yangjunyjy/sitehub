# Cloud application deployment. Middleware is already running on the local VM.
# Cloud images are built from the binaries and web assets in the release package.
# Business timeouts, RPC targets, pool sizes, jobs and governance settings live
# in etcd: SITEHUB group, four configuration keys seeded from etcd/config/*.yaml.
# This file supplies deployment inputs and credentials to config/*.yaml.
IMAGE_PREFIX=sitehub
IMAGE_TAG=local
IMAGE_PLATFORM=linux/amd64

# Linux Docker resolves host.docker.internal through the host-gateway mapping.
FRP_HOST=host.docker.internal
FRP_MYSQL_PORT=25473
FRP_REDIS_PORT=28619
FRP_ETCD_PORT=24167

# Copy the existing credentials from /opt/sitehub-deploy/vm/.env on the local VM.
# They must match the existing accounts; new random passwords cannot reconnect.
RBAC_DB_PASSWORD=
BLOG_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
FILE_DB_PASSWORD=
REDIS_PASSWORD=
# The etcd proxy owns service discovery and remote configuration under this scope.
CONTROL_NAMESPACE=sitehub-dev
# Optional when etcd authentication is enabled; copy the existing account.
ETCD_USERNAME=
ETCD_PASSWORD=

# Generate long random application secrets. Keep STORAGE_SECRET if migrating files.
SERVICE_KEY=
AUTH_SECRET=
STORAGE_SECRET=
GATEWAY_ADMIN_KEY=

# Fill these before running init.sh. Initialization is explicit and runs only
# through the script/init profile; normal application startup does not reset it.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
WEB_COOKIE_SECURE=false
# Optional runtime website origin for admin links/previews, e.g. https://www.example.com.
# Leave empty to use the current browser origin; no domain is embedded at build time.
WEB_SITE_URL=
WEB_PRODUCT_URL=
WEB_BLOG_URL=
GATEWAY_PORT=8082
