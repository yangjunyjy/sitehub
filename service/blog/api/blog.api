syntax = "v1"

info (
	title: "blog service"
)

type Response {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

type FriendApplication {
	Name        string `json:"name"`
	URL         string `json:"url"`
	Description string `json:"description"`
	Avatar      string `json:"avatar,optional"`
}

type GuestPost {
	Nickname string `json:"nickname,optional"`
	Content  string `json:"content"`
}

type CommunityPage {
	Page     int64 `form:"page,optional"`
	PageSize int64 `form:"pageSize,optional"`
}

type SaveStorageRequest {
	Provider    string   `json:"provider,optional"`
	LocalPath   string   `json:"localPath,optional"`
	URLPrefix   string   `json:"urlPrefix,optional"`
	CDN         string   `json:"cdn,optional"`
	Endpoint    string   `json:"endpoint,optional"`
	AccessKey   string   `json:"accessKey,optional"`
	SecretKey   string   `json:"secretKey,optional"`
	Bucket      string   `json:"bucket,optional"`
	Region      string   `json:"region,optional"`
	PathStyle   bool     `json:"pathStyle,optional"`
	AllowedExts []string `json:"allowedExts,optional"`
	MaxSize     int64    `json:"maxSize,optional"`
}

type PublicArticlesRequest {
	Page       int64    `form:"page,optional"`
	PageSize   int64    `form:"pageSize,optional"`
	Title      string   `form:"title,optional"`
	Sort       string   `form:"sort,optional"`
	Status     *int64   `form:"status,optional"`
	CategoryID uint64   `form:"categoryID,optional"`
	TagIDs     []uint64 `form:"tagIDs,optional"`
	Trash      bool     `form:"trash,optional"`
}

type PublicArticleRequest {
	ID uint64 `form:"id,optional"`
}

type AdminArticlesRequest {
	Page       int64    `form:"page,optional"`
	PageSize   int64    `form:"pageSize,optional"`
	Title      string   `form:"title,optional"`
	Sort       string   `form:"sort,optional"`
	Status     *int64   `form:"status,optional"`
	CategoryID uint64   `form:"categoryID,optional"`
	TagIDs     []uint64 `form:"tagIDs,optional"`
	Trash      bool     `form:"trash,optional"`
}

type EditorArticleRequest {
	ID uint64 `form:"id,optional"`
}

type SaveDraftRequest {
	ID        uint64       `json:"id,optional"`
	Version   uint64       `json:"version,optional"`
	RequestID string       `json:"requestID,optional"`
	Input     ArticleInput `json:"input,optional"`
}

type ApplyArticleActionRequest {
	ID          uint64  `json:"id,optional"`
	Version     uint64  `json:"version,optional"`
	RequestID   string  `json:"requestID,optional"`
	Action      string  `json:"action,optional"`
	ScheduledAt *string `json:"scheduledAt,optional"`
	RevisionID  uint64  `json:"revisionID,optional"`
	IsTop       *bool   `json:"isTop,optional"`
}

type GetArticleHistoryRequest {
	ID uint64 `form:"id,optional"`
}

type ArticleRevisionRequest {
	ID         uint64 `form:"id,optional"`
	RevisionID uint64 `form:"revisionId,optional"`
}

type RecordViewRequest {
	ID uint64 `json:"id,optional"`
}

type SearchArticlesRequest {
	Keyword  string `form:"keyword,optional"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type HotArticlesRequest {
	Limit int64 `form:"limit,optional"`
}

type RecentArticlesRequest {
	Limit int64 `form:"limit,optional"`
}

type ListCategoriesRequest {
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
	Name     string `form:"name,optional"`
}

type GetCategoryRequest {
	ID uint64 `form:"id,optional"`
}

type CreateCategoryRequest {
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
	Icon        *string `json:"icon,optional"`
	ParentID    *uint64 `json:"parentId,optional"`
	SortOrder   int64   `json:"sortOrder,optional"`
}

type UpdateCategoryRequest {
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
	Icon        *string `json:"icon,optional"`
	ParentID    *uint64 `json:"parentId,optional"`
	SortOrder   int64   `json:"sortOrder,optional"`
}

type DeleteCategoryRequest {
	ID uint64 `json:"id,optional"`
}

type ListTagsRequest {
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
	Name     string `form:"name,optional"`
}

type GetTagRequest {
	ID uint64 `form:"id,optional"`
}

type CreateTagRequest {
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
}

type UpdateTagRequest {
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
}

type DeleteTagRequest {
	ID uint64 `json:"id,optional"`
}

type ArticleTrendRequest {
	Days int64 `form:"days,optional"`
}

type ViewTrendRequest {
	Days int64 `form:"days,optional"`
}

type CategoryStatsRequest {
	Limit int64 `form:"limit,optional"`
}

type TagStatsRequest {
	Limit int64 `form:"limit,optional"`
}

type HotTagsRequest {
	Limit int64 `form:"limit,optional"`
}

type HotArticleStatsRequest {
	Limit int64 `form:"limit,optional"`
}

type ArticleInput {
	Title         string   `json:"title,optional"`
	Slug          string   `json:"slug,optional"`
	Summary       string   `json:"summary,optional"`
	Content       string   `json:"content,optional"`
	ContentFormat string   `json:"content_format,optional"`
	Cover         string   `json:"cover,optional"`
	CategoryID    uint64   `json:"category_id,optional"`
	TagIDs        []uint64 `json:"tag_ids,optional"`
}

service blog-api {
	@handler ListFriends
	get /v1/blog/friends returns (Response)

	@handler ApplyFriend
	post /v1/blog/friends (FriendApplication) returns (Response)

	@handler ListMessages
	get /v1/blog/messages (CommunityPage) returns (Response)

	@handler SendMessage
	post /v1/blog/messages (GuestPost) returns (Response)

	@handler GetAbout
	get /v1/blog/about returns (Response)

	@handler Health
	get /health returns (Response)

	@handler PublicArticles
	get /v1/blog/articles (PublicArticlesRequest) returns (Response)

	@handler PublicArticle
	get /v1/blog/articles/detail (PublicArticleRequest) returns (Response)

	@handler AdminArticles
	get /v1/blog/admin/articles (AdminArticlesRequest) returns (Response)

	@handler EditorArticle
	get /v1/blog/admin/articles/detail (EditorArticleRequest) returns (Response)

	@handler GetArticleOptions
	get /v1/blog/admin/articles/options returns (Response)

	@handler SaveDraft
	post /v1/blog/admin/articles/draft (SaveDraftRequest) returns (Response)

	@handler ApplyArticleAction
	post /v1/blog/admin/articles/action (ApplyArticleActionRequest) returns (Response)

	@handler GetArticleHistory
	get /v1/blog/admin/articles/history (GetArticleHistoryRequest) returns (Response)

	@handler ArticleRevision
	get /v1/blog/admin/articles/revision (ArticleRevisionRequest) returns (Response)

	@handler RecordView
	post /v1/blog/articles/view (RecordViewRequest) returns (Response)

	@handler SearchArticles
	get /v1/blog/articles/search (SearchArticlesRequest) returns (Response)

	@handler HotArticles
	get /v1/blog/articles/hot (HotArticlesRequest) returns (Response)

	@handler RecentArticles
	get /v1/blog/articles/recent (RecentArticlesRequest) returns (Response)

	@handler ListCategories
	get /v1/blog/categories (ListCategoriesRequest) returns (Response)

	@handler GetCategory
	get /v1/blog/categories/detail (GetCategoryRequest) returns (Response)

	@handler CreateCategory
	post /v1/blog/categories/create (CreateCategoryRequest) returns (Response)

	@handler UpdateCategory
	post /v1/blog/categories/update (UpdateCategoryRequest) returns (Response)

	@handler DeleteCategory
	post /v1/blog/categories/delete (DeleteCategoryRequest) returns (Response)

	@handler ListTags
	get /v1/blog/tags (ListTagsRequest) returns (Response)

	@handler GetTag
	get /v1/blog/tags/detail (GetTagRequest) returns (Response)

	@handler CreateTag
	post /v1/blog/tags/create (CreateTagRequest) returns (Response)

	@handler UpdateTag
	post /v1/blog/tags/update (UpdateTagRequest) returns (Response)

	@handler DeleteTag
	post /v1/blog/tags/delete (DeleteTagRequest) returns (Response)

	@handler CategoryTree
	get /v1/blog/categories/tree returns (Response)

	@handler Dashboard
	get /v1/blog/statistics/dashboard returns (Response)

	@handler GetArticleStats
	get /v1/blog/statistics/articlestats returns (Response)

	@handler ArticleTrend
	get /v1/blog/statistics/articletrend (ArticleTrendRequest) returns (Response)

	@handler ViewTrend
	get /v1/blog/statistics/viewtrend (ViewTrendRequest) returns (Response)

	@handler CategoryStats
	get /v1/blog/statistics/categorystats (CategoryStatsRequest) returns (Response)

	@handler TagStats
	get /v1/blog/statistics/tagstats (TagStatsRequest) returns (Response)

	@handler HotTags
	get /v1/blog/statistics/hottags (HotTagsRequest) returns (Response)

	@handler HotArticleStats
	get /v1/blog/statistics/hotarticlestats (HotArticleStatsRequest) returns (Response)

	@handler GetStorage
	get /v1/file/settings returns (Response)

	@handler SaveStorage
	post /v1/file/settings (SaveStorageRequest) returns (Response)
}

