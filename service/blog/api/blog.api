syntax = "v1"

info (
	title: "blog service"
)

type Response {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

type HomeSettingsRequest {
	HomeAnimation bool   `json:"homeAnimation"`
	HomeVerse     string `json:"homeVerse"`
}

type FriendApplication {
	Name        string `json:"name"`
	URL         string `json:"url"`
	Description string `json:"description"`
	Avatar      string `json:"avatar,optional"`
}

type ArticleInteractionQuery {
	ArticleID uint64 `form:"articleId"`
}

type LikeArticleRequest {
	ArticleID uint64 `json:"articleId"`
	Liked     bool   `json:"liked"`
}

type FavoriteArticleRequest {
	ArticleID uint64 `json:"articleId"`
	Favorited bool   `json:"favorited"`
	FolderID  uint64 `json:"folderId,optional"`
}

type CreateFavoriteFolderRequest {
	Name string `json:"name"`
}

type FavoriteArticlesQuery {
	FolderID uint64 `form:"folderId,optional"`
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"pageSize,default=20"`
}

type GuestPost {
	ArticleID uint64 `json:"articleId,optional"`
	Nickname  string `json:"nickname,optional"`
	Content   string `json:"content"`
}

type CommunityPage {
	ArticleID uint64 `form:"articleId,optional"`
	Page      int64  `form:"page,optional"`
	PageSize  int64  `form:"pageSize,optional"`
}

type ReviewQueue {
	Kind   string `form:"kind"`
	Status string `form:"status"`
	Page   int    `form:"page,optional"`
}

type ReviewDecision {
	Kind   string `json:"kind"`
	Status string `json:"status"`
	ID     uint64 `json:"id"`
}

type StorageSettings {
	Provider    string   `json:"provider,optional"`
	LocalPath   string   `json:"localPath,optional"`
	URLPrefix   string   `json:"urlPrefix,optional"`
	CDN         string   `json:"cdn,optional"`
	Endpoint    string   `json:"endpoint,optional"`
	AccessKey   string   `json:"accessKey,optional"`
	SecretKey   string   `json:"secretKey,optional"`
	Bucket      string   `json:"bucket,optional"`
	Region      string   `json:"region,optional"`
	PathStyle   bool     `json:"pathStyle,optional"`
	AllowedExts []string `json:"allowedExts,optional"`
	MaxSize     int64    `json:"maxSize,optional"`
}

type FileIDRequest {
	ID string `form:"id"`
}

type LocalFileRequest {
	Kind string `path:"kind"`
	Name string `path:"name"`
}

type ValidateReleaseRequest {
	Location string `json:"location"`
}

type PublicArticlesRequest {
	Page       int64    `form:"page,optional"`
	PageSize   int64    `form:"pageSize,optional"`
	Title      string   `form:"title,optional"`
	Sort       string   `form:"sort,optional"`
	Status     *int64   `form:"status,optional"`
	CategoryID uint64   `form:"categoryID,optional"`
	TagIDs     []uint64 `form:"tagIDs,optional"`
	Trash      bool     `form:"trash,optional"`
}

type PublicArticleRequest {
	ID uint64 `form:"id,optional"`
}

type AdminArticlesRequest {
	Page       int64    `form:"page,optional"`
	PageSize   int64    `form:"pageSize,optional"`
	Title      string   `form:"title,optional"`
	Sort       string   `form:"sort,optional"`
	Status     *int64   `form:"status,optional"`
	CategoryID uint64   `form:"categoryID,optional"`
	TagIDs     []uint64 `form:"tagIDs,optional"`
	Trash      bool     `form:"trash,optional"`
}

type EditorArticleRequest {
	ID uint64 `form:"id,optional"`
}

type SaveDraftRequest {
	ID        uint64       `json:"id,optional"`
	Version   uint64       `json:"version,optional"`
	RequestID string       `json:"requestID,optional"`
	Input     ArticleInput `json:"input,optional"`
}

type ApplyArticleActionRequest {
	ID          uint64  `json:"id,optional"`
	Version     uint64  `json:"version,optional"`
	RequestID   string  `json:"requestID,optional"`
	Action      string  `json:"action,optional"`
	ScheduledAt *string `json:"scheduledAt,optional"`
	RevisionID  uint64  `json:"revisionID,optional"`
	IsTop       *bool   `json:"isTop,optional"`
}

type GetArticleHistoryRequest {
	ID uint64 `form:"id,optional"`
}

type ArticleRevisionRequest {
	ID         uint64 `form:"id,optional"`
	RevisionID uint64 `form:"revisionId,optional"`
}

type RecordViewRequest {
	ID uint64 `json:"id,optional"`
}

type SearchArticlesRequest {
	Keyword  string `form:"keyword,optional"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type HotArticlesRequest {
	Limit int64 `form:"limit,optional"`
}

type RecentArticlesRequest {
	Limit int64 `form:"limit,optional"`
}

type ListCategoriesRequest {
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
	Name     string `form:"name,optional"`
}

type GetCategoryRequest {
	ID uint64 `form:"id,optional"`
}

type CreateCategoryRequest {
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
	Icon        *string `json:"icon,optional"`
	ParentID    *uint64 `json:"parentId,optional"`
	SortOrder   int64   `json:"sortOrder,optional"`
}

type UpdateCategoryRequest {
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
	Icon        *string `json:"icon,optional"`
	ParentID    *uint64 `json:"parentId,optional"`
	SortOrder   int64   `json:"sortOrder,optional"`
}

type DeleteCategoryRequest {
	ID uint64 `json:"id,optional"`
}

type ListTagsRequest {
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
	Name     string `form:"name,optional"`
}

type GetTagRequest {
	ID uint64 `form:"id,optional"`
}

type CreateTagRequest {
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
}

type UpdateTagRequest {
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Slug        string  `json:"slug,optional"`
	Description *string `json:"description,optional"`
}

type DeleteTagRequest {
	ID uint64 `json:"id,optional"`
}

type ArticleTrendRequest {
	Days int64 `form:"days,optional"`
}

type ViewTrendRequest {
	Days int64 `form:"days,optional"`
}

type CategoryStatsRequest {
	Limit int64 `form:"limit,optional"`
}

type TagStatsRequest {
	Limit int64 `form:"limit,optional"`
}

type HotTagsRequest {
	Limit int64 `form:"limit,optional"`
}

type HotArticleStatsRequest {
	Limit int64 `form:"limit,optional"`
}

type ArticleInput {
	Title         string   `json:"title,optional"`
	Slug          string   `json:"slug,optional"`
	Summary       string   `json:"summary,optional"`
	Content       string   `json:"content,optional"`
	ContentFormat string   `json:"content_format,optional"`
	Cover         string   `json:"cover,optional"`
	CategoryID    uint64   `json:"category_id,optional"`
	TagIDs        []uint64 `json:"tag_ids,optional"`
}

@server (
	group:  community
	prefix: /v1/blog
)
service blog-api {
	@handler ListFriends
	get /friends returns (Response)

	@handler ApplyFriend
	post /friends (FriendApplication) returns (Response)

	@handler ListMessages
	get /messages (CommunityPage) returns (Response)

	@handler SendMessage
	post /messages (GuestPost) returns (Response)
}

@server (
	group:  review
	prefix: /v1/blog/admin
)
service blog-api {
	@handler CommunityReviewQueue
	get /community (ReviewQueue) returns (Response)

	@handler ReviewCommunity
	post /community (ReviewDecision) returns (Response)
}

@server (
	group:  settings
	prefix: /v1/blog
)
service blog-api {
	@handler GetAbout
	get /about returns (Response)

	@handler SaveHomeSettings
	post /home/settings (HomeSettingsRequest) returns (Response)
}

@server (
	group: health
)
service blog-api {
	@handler Health
	get /health returns (Response)
}

@server (
	group:  articles
	prefix: /v1/blog
)
service blog-api {
	@handler PublicArticles
	get /articles (PublicArticlesRequest) returns (Response)

	@handler PublicArticle
	get /articles/detail (PublicArticleRequest) returns (Response)

	@handler RecordView
	post /articles/view (RecordViewRequest) returns (Response)

	@handler SearchArticles
	get /articles/search (SearchArticlesRequest) returns (Response)

	@handler HotArticles
	get /articles/hot (HotArticlesRequest) returns (Response)

	@handler RecentArticles
	get /articles/recent (RecentArticlesRequest) returns (Response)
}

@server (
	group:  editor
	prefix: /v1/blog/admin
)
service blog-api {
	@handler AdminArticles
	get /articles (AdminArticlesRequest) returns (Response)

	@handler EditorArticle
	get /articles/detail (EditorArticleRequest) returns (Response)

	@handler GetArticleOptions
	get /articles/options returns (Response)

	@handler SaveDraft
	post /articles/draft (SaveDraftRequest) returns (Response)

	@handler ApplyArticleAction
	post /articles/action (ApplyArticleActionRequest) returns (Response)

	@handler GetArticleHistory
	get /articles/history (GetArticleHistoryRequest) returns (Response)

	@handler ArticleRevision
	get /articles/revision (ArticleRevisionRequest) returns (Response)
}

@server (
	group:  categories
	prefix: /v1/blog
)
service blog-api {
	@handler ListCategories
	get /categories (ListCategoriesRequest) returns (Response)

	@handler GetCategory
	get /categories/detail (GetCategoryRequest) returns (Response)

	@handler CreateCategory
	post /categories/create (CreateCategoryRequest) returns (Response)

	@handler UpdateCategory
	post /categories/update (UpdateCategoryRequest) returns (Response)

	@handler DeleteCategory
	post /categories/delete (DeleteCategoryRequest) returns (Response)

	@handler CategoryTree
	get /categories/tree returns (Response)
}

@server (
	group:  tags
	prefix: /v1/blog
)
service blog-api {
	@handler ListTags
	get /tags (ListTagsRequest) returns (Response)

	@handler GetTag
	get /tags/detail (GetTagRequest) returns (Response)

	@handler CreateTag
	post /tags/create (CreateTagRequest) returns (Response)

	@handler UpdateTag
	post /tags/update (UpdateTagRequest) returns (Response)

	@handler DeleteTag
	post /tags/delete (DeleteTagRequest) returns (Response)
}

@server (
	group:  statistics
	prefix: /v1/blog
)
service blog-api {
	@handler Dashboard
	get /statistics/dashboard returns (Response)

	@handler GetArticleStats
	get /statistics/articlestats returns (Response)

	@handler ArticleTrend
	get /statistics/articletrend (ArticleTrendRequest) returns (Response)

	@handler ViewTrend
	get /statistics/viewtrend (ViewTrendRequest) returns (Response)

	@handler CategoryStats
	get /statistics/categorystats (CategoryStatsRequest) returns (Response)

	@handler TagStats
	get /statistics/tagstats (TagStatsRequest) returns (Response)

	@handler HotTags
	get /statistics/hottags (HotTagsRequest) returns (Response)

	@handler HotArticleStats
	get /statistics/hotarticlestats (HotArticleStatsRequest) returns (Response)
}

@server (
	group:  storage
	prefix: /v1/file
)
service blog-api {
	@handler GetStorage
	get /settings returns (Response)

	@handler SaveStorage
	post /settings (StorageSettings) returns (Response)
}

@server (
	group:    assets
	prefix:   /v1/blog
	timeout:  10m
	maxBytes: 53477376
)
service blog-api {
	// Multipart article upload, including up to 1 MiB of form overhead.
	@handler UploadAsset
	post /assets/upload returns (Response)

	@handler ReadAsset
	get /assets (FileIDRequest)

	@handler HeadAsset
	head /assets (FileIDRequest)
}

@server (
	group:    files
	prefix:   /v1/file
	timeout:  10m
	maxBytes: 2148532224
)
service blog-api {
	// Multipart upload for images, attachments and releases.
	@handler UploadFile
	post /upload returns (Response)

	@handler DownloadFile
	get /download (FileIDRequest)

	@handler HeadDownload
	head /download (FileIDRequest)

	@handler ReadLocalFile
	get /local/:kind/:name (LocalFileRequest)

	@handler HeadLocalFile
	head /local/:kind/:name (LocalFileRequest)
}

@server (
	group:  storage
	prefix: /internal/blog
)
service blog-api {
	@handler ReadInternalStorage
	get /storage returns (StorageSettings)

	@handler SaveInternalStorage
	put /storage (StorageSettings)

	@handler EnsureStorageDefaults
	post /storage/defaults

	@handler ValidateRelease
	post /storage/validate (ValidateReleaseRequest)
}

@server (
	group:  reader
	prefix: /v1/blog
)
service blog-api {
	@handler ArticleInteraction
	get /articles/interaction (ArticleInteractionQuery) returns (Response)

	@handler LikeArticle
	post /articles/like (LikeArticleRequest) returns (Response)

	@handler FavoriteArticle
	post /articles/favorite (FavoriteArticleRequest) returns (Response)

	@handler FavoriteFolders
	get /favorites/folders returns (Response)

	@handler CreateFavoriteFolder
	post /favorites/folders (CreateFavoriteFolderRequest) returns (Response)

	@handler FavoriteArticles
	get /favorites/articles (FavoriteArticlesQuery) returns (Response)
}

