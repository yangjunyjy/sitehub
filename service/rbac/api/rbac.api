syntax = "v1"

info (
	title: "rbac service"
)

type Response {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

type VerifyCaptchaRequest {
	CaptchaKey string `json:"captchaKey,optional"`
	SliderX    int64  `json:"sliderX,optional"`
	Duration   int64  `json:"duration,optional"`
	MoveCount  int64  `json:"moveCount,optional"`
}

type SendAdminCodeRequest {
	Email      string `json:"email,optional"`
	CaptchaKey string `json:"captchaKey,optional"`
}

type LoginRequest {
	Username string `json:"username,optional"`
	Password string `json:"password,optional"`
	Email    string `json:"email,optional"`
	Code     string `json:"code,optional"`
}

type ChangePasswordRequest {
	Email       string `json:"email,optional"`
	OldPassword string `json:"oldPassword,optional"`
	NewPassword string `json:"newPassword,optional"`
}

type SendMemberCodeRequest {
	Email      string `json:"email,optional"`
	CaptchaKey string `json:"captchaKey,optional"`
}

type RegisterMemberRequest {
	Email    string `json:"email,optional"`
	Password string `json:"password,optional"`
	Code     string `json:"code,optional"`
}

type LoginMemberRequest {
	Email    string `json:"email,optional"`
	Password string `json:"password,optional"`
}

type ListUsersRequest {
	Username string  `form:"username,optional"`
	Email    string  `form:"email,optional"`
	Status   *uint64 `form:"status,optional"`
	Page     int64   `form:"page,optional"`
	PageSize int64   `form:"pageSize,optional"`
}

type GetUserRequest {
	ID uint64 `form:"id,optional"`
}

type CreateUserRequest {
	Username string `json:"username,optional"`
	Nickname string `json:"nickname,optional"`
	Password string `json:"password,optional"`
	Email    string `json:"email,optional"`
	Status   uint64 `json:"status,optional"`
	Gender   uint64 `json:"gender,optional"`
}

type UpdateUserRequest {
	Id       uint64 `json:"id,optional"`
	UserName string `json:"username,optional"`
	Nickname string `json:"nickname,optional"`
	Password string `json:"password,optional"`
	Email    string `json:"email,optional"`
	Status   uint64 `json:"status,optional"`
	Gender   uint64 `json:"gender,optional"`
}

type DeleteUserRequest {
	ID uint64 `json:"id,optional"`
}

type AssignRolesRequest {
	UserID  uint64   `json:"userId,optional"`
	RoleIDs []uint64 `json:"roleIds,optional"`
}

type ListRolesRequest {
	RoleName string `form:"roleName,optional"`
	RoleCode string `form:"roleCode,optional"`
	Status   *int64 `form:"status,optional"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type GetRoleRequest {
	ID uint64 `form:"id,optional"`
}

type CreateRoleRequest {
	RoleCode string `json:"role_code,optional"`
	RoleName string `json:"role_name,optional"`
	RoleDesc string `json:"role_desc,optional"`
	Status   int64  `json:"status,optional"`
}

type UpdateRoleRequest {
	ID       uint64 `json:"id,optional"`
	RoleCode string `json:"role_code,optional"`
	RoleName string `json:"role_name,optional"`
	RoleDesc string `json:"role_desc,optional"`
	Status   int64  `json:"status,optional"`
}

type DeleteRoleRequest {
	ID uint64 `json:"id,optional"`
}

type AssignMenusRequest {
	RoleID  uint64   `json:"role_id,optional"`
	MenuIDs []uint64 `json:"menu_ids,optional"`
}

type RoleMenusRequest {
	ID uint64 `form:"id,optional"`
}

type GetMenuRequest {
	ID uint64 `form:"id,optional"`
}

type CreateMenuRequest {
	SystemCode  string  `json:"systemCode,optional"`
	Permission  string  `json:"permission,optional"`
	Name        string  `json:"name,optional"`
	Code        string  `json:"code,optional"`
	Type        uint64  `json:"type,optional"`
	Status      *uint64 `json:"status,optional"`
	ParentID    uint64  `json:"parent_id,optional"`
	Sort        int64   `json:"sort,optional"`
	Component   string  `json:"component,optional"`
	Path        string  `json:"path,optional"`
	Description string  `json:"description,optional"`
	IsVisible   bool    `json:"isVisible,optional"`
	Icon        string  `json:"icon,optional"`
}

type UpdateMenuRequest {
	SystemCode  string  `json:"systemCode,optional"`
	Permission  string  `json:"permission,optional"`
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Code        string  `json:"code,optional"`
	Type        uint64  `json:"type,optional"`
	Status      *uint64 `json:"status,optional"`
	ParentID    uint64  `json:"parent_id,optional"`
	Sort        int64   `json:"sort,optional"`
	Component   string  `json:"component,optional"`
	Path        string  `json:"path,optional"`
	Description string  `json:"description,optional"`
	IsVisible   bool    `json:"isVisible,optional"`
	Icon        string  `json:"icon,optional"`
}

type DeleteMenuRequest {
	ID uint64 `json:"id,optional"`
}

type SystemRequest {
	System string `form:"system,optional"`
}

type SaveSystemRequest {
	ID          uint64 `json:"id,optional"`
	Code        string `json:"code"`
	Name        string `json:"name"`
	Description string `json:"description,optional"`
	Origin      string `json:"origin,optional"`
	Enabled     bool   `json:"enabled"`
	Public      bool   `json:"public"`
}

type DeleteSystemRequest {
	ID uint64 `json:"id"`
}

type SaveEmailSettingsRequest {
	SMTPHost  string  `json:"smtpHost,optional"`
	SMTPPort  int64   `json:"smtpPort,optional"`
	FromEmail string  `json:"fromEmail,optional"`
	FromName  string  `json:"fromName,optional"`
	Subject   string  `json:"subject,optional"`
	Password  *string `json:"password,optional"`
}

type BlockIPRequest {
	ID     uint64 `json:"id,optional"`
	IP     string `json:"ip,optional"`
	Reason string `json:"reason,optional"`
}

type UnblockIPRequest {
	ID     uint64 `json:"id,optional"`
	IP     string `json:"ip,optional"`
	Reason string `json:"reason,optional"`
}

type ConsumeTokenRequest {
	Token string `json:"token"`
}

service rbac-api {
	@handler ConsumeToken
	post /v1/rbac/auth/once-token/consume (ConsumeTokenRequest) returns (Response)

	@handler Health
	get /health returns (Response)

	@handler Captcha
	get /v1/rbac/captcha returns (Response)

	@handler VerifyCaptcha
	post /v1/rbac/captcha/verify (VerifyCaptchaRequest) returns (Response)

	@handler SendAdminCode
	post /v1/rbac/auth/code (SendAdminCodeRequest) returns (Response)

	@handler Login
	post /v1/rbac/auth/login (LoginRequest) returns (Response)

	@handler Logout
	post /v1/rbac/auth/logout returns (Response)

	@handler CurrentUser
	get /v1/rbac/auth/me returns (Response)

	@handler CurrentPermissions
	get /v1/rbac/auth/permissions returns (Response)

	@handler CurrentMenus
	get /v1/rbac/auth/menus returns (Response)

	@handler OnceToken
	post /v1/rbac/auth/once-token returns (Response)

	@handler TOTPStatus
	get /v1/rbac/auth/totp returns (Response)

	@handler ChangePassword
	post /v1/rbac/auth/password (ChangePasswordRequest) returns (Response)

	@handler SendMemberCode
	post /v1/rbac/members/code (SendMemberCodeRequest) returns (Response)

	@handler RegisterMember
	post /v1/rbac/members/register (RegisterMemberRequest) returns (Response)

	@handler LoginMember
	post /v1/rbac/members/login (LoginMemberRequest) returns (Response)

	@handler CurrentMember
	get /v1/rbac/members/me returns (Response)

	@handler LogoutMember
	post /v1/rbac/members/logout returns (Response)

	@handler ListUsers
	get /v1/rbac/users (ListUsersRequest) returns (Response)

	@handler GetUser
	get /v1/rbac/users/detail (GetUserRequest) returns (Response)

	@handler CreateUser
	post /v1/rbac/users/create (CreateUserRequest) returns (Response)

	@handler UpdateUser
	post /v1/rbac/users/update (UpdateUserRequest) returns (Response)

	@handler DeleteUser
	post /v1/rbac/users/delete (DeleteUserRequest) returns (Response)

	@handler AssignRoles
	post /v1/rbac/users/roles (AssignRolesRequest) returns (Response)

	@handler ListRoles
	get /v1/rbac/roles (ListRolesRequest) returns (Response)

	@handler GetRole
	get /v1/rbac/roles/detail (GetRoleRequest) returns (Response)

	@handler CreateRole
	post /v1/rbac/roles/create (CreateRoleRequest) returns (Response)

	@handler UpdateRole
	post /v1/rbac/roles/update (UpdateRoleRequest) returns (Response)

	@handler DeleteRole
	post /v1/rbac/roles/delete (DeleteRoleRequest) returns (Response)

	@handler AssignMenus
	post /v1/rbac/roles/menus (AssignMenusRequest) returns (Response)

	@handler RoleMenus
	get /v1/rbac/roles/menus (RoleMenusRequest) returns (Response)

	@handler MenuList
	get /v1/rbac/menus (SystemRequest) returns (Response)

	@handler MenuTree
	get /v1/rbac/menus/tree (SystemRequest) returns (Response)

	@handler PublicMenus
	get /v1/rbac/menus/public (SystemRequest) returns (Response)

	@handler ListSystems
	get /v1/rbac/systems returns (Response)

	@handler SaveSystem
	post /v1/rbac/systems/save (SaveSystemRequest) returns (Response)

	@handler DeleteSystem
	post /v1/rbac/systems/delete (DeleteSystemRequest) returns (Response)

	@handler GetMenu
	get /v1/rbac/menus/detail (GetMenuRequest) returns (Response)

	@handler CreateMenu
	post /v1/rbac/menus/create (CreateMenuRequest) returns (Response)

	@handler UpdateMenu
	post /v1/rbac/menus/update (UpdateMenuRequest) returns (Response)

	@handler DeleteMenu
	post /v1/rbac/menus/delete (DeleteMenuRequest) returns (Response)

	@handler GetEmailSettings
	get /v1/rbac/settings/email returns (Response)

	@handler SaveEmailSettings
	post /v1/rbac/settings/email (SaveEmailSettingsRequest) returns (Response)

	@handler Blacklist
	get /v1/rbac/blacklist returns (Response)

	@handler BlockIP
	post /v1/rbac/blacklist/add (BlockIPRequest) returns (Response)

	@handler UnblockIP
	post /v1/rbac/blacklist/delete (UnblockIPRequest) returns (Response)
}

