syntax = "v1"

info (
	title: "rbac service"
)

type Response {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

type VerifyCaptchaRequest {
	CaptchaKey string `json:"captchaKey,optional"`
	SliderX    int64  `json:"sliderX,optional"`
	Duration   int64  `json:"duration,optional"`
	MoveCount  int64  `json:"moveCount,optional"`
}

type SendAdminCodeRequest {
	Email      string `json:"email,optional"`
	CaptchaKey string `json:"captchaKey,optional"`
}

type LoginRequest {
	Username string `json:"username,optional"`
	Password string `json:"password,optional"`
	Email    string `json:"email,optional"`
	Code     string `json:"code,optional"`
}

type ChangePasswordRequest {
	Email       string `json:"email,optional"`
	OldPassword string `json:"oldPassword,optional"`
	NewPassword string `json:"newPassword,optional"`
}

type SendMemberCodeRequest {
	Email      string `json:"email,optional"`
	CaptchaKey string `json:"captchaKey,optional"`
}

type RegisterMemberRequest {
	Username string `json:"username"`
	Nickname string `json:"nickname"`
	Email    string `json:"email,optional"`
	Password string `json:"password,optional"`
	Code     string `json:"code,optional"`
}

type ResetMemberPasswordRequest {
	Email    string `json:"email"`
	Password string `json:"password"`
	Code     string `json:"code"`
}

type UpdateMemberProfileRequest {
	Username string `json:"username"`
	Nickname string `json:"nickname"`
	Avatar   string `json:"avatar,optional"`
}

type LoginMemberRequest {
	Account  string `json:"account,optional"`
	Email    string `json:"email,optional"`
	Password string `json:"password,optional"`
}

type ListUsersRequest {
	Username string  `form:"username,optional"`
	Email    string  `form:"email,optional"`
	Status   *uint64 `form:"status,optional"`
	Page     int64   `form:"page,optional"`
	PageSize int64   `form:"pageSize,optional"`
}

type GetUserRequest {
	ID uint64 `form:"id,optional"`
}

type CreateUserRequest {
	Username string `json:"username,optional"`
	Nickname string `json:"nickname,optional"`
	Password string `json:"password,optional"`
	Email    string `json:"email,optional"`
	Status   uint64 `json:"status,optional"`
	Gender   uint64 `json:"gender,optional"`
}

type UpdateUserRequest {
	Id       uint64 `json:"id,optional"`
	UserName string `json:"username,optional"`
	Nickname string `json:"nickname,optional"`
	Password string `json:"password,optional"`
	Email    string `json:"email,optional"`
	Status   uint64 `json:"status,optional"`
	Gender   uint64 `json:"gender,optional"`
}

type DeleteUserRequest {
	ID uint64 `json:"id,optional"`
}

type AssignRolesRequest {
	UserID  uint64   `json:"userId,optional"`
	RoleIDs []uint64 `json:"roleIds,optional"`
}

type ListRolesRequest {
	RoleName string `form:"roleName,optional"`
	RoleCode string `form:"roleCode,optional"`
	Status   *int64 `form:"status,optional"`
	Page     int64  `form:"page,optional"`
	PageSize int64  `form:"pageSize,optional"`
}

type GetRoleRequest {
	ID uint64 `form:"id,optional"`
}

type CreateRoleRequest {
	RoleCode string `json:"role_code,optional"`
	RoleName string `json:"role_name,optional"`
	RoleDesc string `json:"role_desc,optional"`
	Status   int64  `json:"status,optional"`
}

type UpdateRoleRequest {
	ID       uint64 `json:"id,optional"`
	RoleCode string `json:"role_code,optional"`
	RoleName string `json:"role_name,optional"`
	RoleDesc string `json:"role_desc,optional"`
	Status   int64  `json:"status,optional"`
}

type DeleteRoleRequest {
	ID uint64 `json:"id,optional"`
}

type AssignMenusRequest {
	RoleID  uint64   `json:"role_id,optional"`
	MenuIDs []uint64 `json:"menu_ids,optional"`
}

type RoleMenusRequest {
	ID uint64 `form:"id,optional"`
}

type GetMenuRequest {
	ID uint64 `form:"id,optional"`
}

type CreateMenuRequest {
	PageType    string  `json:"pageType,optional"`
	ExternalURL string  `json:"externalUrl,optional"`
	SystemCode  string  `json:"systemCode,optional"`
	Permission  string  `json:"permission,optional"`
	Name        string  `json:"name,optional"`
	Code        string  `json:"code,optional"`
	Type        uint64  `json:"type,optional"`
	Status      *uint64 `json:"status,optional"`
	ParentID    uint64  `json:"parent_id,optional"`
	Sort        int64   `json:"sort,optional"`
	Component   string  `json:"component,optional"`
	Path        string  `json:"path,optional"`
	Description string  `json:"description,optional"`
	IsVisible   bool    `json:"isVisible,optional"`
	Icon        string  `json:"icon,optional"`
}

type UpdateMenuRequest {
	PageType    string  `json:"pageType,optional"`
	ExternalURL string  `json:"externalUrl,optional"`
	SystemCode  string  `json:"systemCode,optional"`
	Permission  string  `json:"permission,optional"`
	ID          uint64  `json:"id,optional"`
	Name        string  `json:"name,optional"`
	Code        string  `json:"code,optional"`
	Type        uint64  `json:"type,optional"`
	Status      *uint64 `json:"status,optional"`
	ParentID    uint64  `json:"parent_id,optional"`
	Sort        int64   `json:"sort,optional"`
	Component   string  `json:"component,optional"`
	Path        string  `json:"path,optional"`
	Description string  `json:"description,optional"`
	IsVisible   bool    `json:"isVisible,optional"`
	Icon        string  `json:"icon,optional"`
}

type DeleteMenuRequest {
	ID uint64 `json:"id,optional"`
}

type SystemRequest {
	System string `form:"system,optional"`
}

type SaveSystemRequest {
	ID          uint64 `json:"id,optional"`
	Code        string `json:"code"`
	Name        string `json:"name"`
	Description string `json:"description,optional"`
	Origin      string `json:"origin,optional"`
	Enabled     bool   `json:"enabled"`
	Public      bool   `json:"public"`
}

type DeleteSystemRequest {
	ID uint64 `json:"id"`
}

type SaveEmailSettingsRequest {
	SMTPHost  string  `json:"smtpHost,optional"`
	SMTPPort  int64   `json:"smtpPort,optional"`
	FromEmail string  `json:"fromEmail,optional"`
	FromName  string  `json:"fromName,optional"`
	Subject   string  `json:"subject,optional"`
	Password  *string `json:"password,optional"`
}

type BlockIPRequest {
	ID     uint64 `json:"id,optional"`
	IP     string `json:"ip,optional"`
	Reason string `json:"reason,optional"`
}

type UnblockIPRequest {
	ID     uint64 `json:"id,optional"`
	IP     string `json:"ip,optional"`
	Reason string `json:"reason,optional"`
}

type ConsumeTokenRequest {
	Token string `json:"token"`
}

type IconContentRequest {
	Name string `form:"name"`
}

type IconInput {
	Name     string `json:"name"`
	Label    string `json:"label,optional"`
	Category string `json:"category,optional"`
	SVG      string `json:"svg"`
}

type UpdateIconRequest {
	ID uint64 `json:"id"`
	IconInput
}

type DeleteIconRequest {
	ID uint64 `json:"id"`
}

@server (
	group:  icons
	prefix: /v1/rbac
)
service rbac-api {
	@handler ListIcons
	get /system/icons returns (Response)

	@handler IconContent
	get /system/icons/content (IconContentRequest)

	@handler ValidateIcon
	post /system/icons/validate (IconInput) returns (Response)

	@handler CreateIcon
	post /system/icons/create (IconInput) returns (Response)

	@handler UpdateIcon
	post /system/icons/update (UpdateIconRequest) returns (Response)

	@handler DeleteIcon
	post /system/icons/delete (DeleteIconRequest) returns (Response)
}

@server (
	group:  auth
	prefix: /v1/rbac
)
service rbac-api {
	@handler ConsumeToken
	post /auth/once-token/consume (ConsumeTokenRequest) returns (Response)

	@handler SendAdminCode
	post /auth/code (SendAdminCodeRequest) returns (Response)

	@handler Login
	post /auth/login (LoginRequest) returns (Response)

	@handler Logout
	post /auth/logout returns (Response)

	@handler CurrentUser
	get /auth/me returns (Response)

	@handler CurrentPermissions
	get /auth/permissions returns (Response)

	@handler CurrentMenus
	get /auth/menus returns (Response)

	@handler OnceToken
	post /auth/once-token returns (Response)

	@handler TOTPStatus
	get /auth/totp returns (Response)

	@handler ChangePassword
	post /auth/password (ChangePasswordRequest) returns (Response)
}

@server (
	group: health
)
service rbac-api {
	@handler Health
	get /health returns (Response)
}

@server (
	group:  captcha
	prefix: /v1/rbac
)
service rbac-api {
	@handler Captcha
	get /captcha returns (Response)

	@handler VerifyCaptcha
	post /captcha/verify (VerifyCaptchaRequest) returns (Response)
}

@server (
	group:  members
	prefix: /v1/rbac
)
service rbac-api {
	@handler SendMemberCode
	post /members/code (SendMemberCodeRequest) returns (Response)

	@handler RegisterMember
	post /members/register (RegisterMemberRequest) returns (Response)

	@handler LoginMember
	post /members/login (LoginMemberRequest) returns (Response)

	@handler SendMemberResetCode
	post /members/password/code (SendMemberCodeRequest) returns (Response)

	@handler ResetMemberPassword
	post /members/password/reset (ResetMemberPasswordRequest) returns (Response)

	@handler UpdateMemberProfile
	post /members/profile (UpdateMemberProfileRequest) returns (Response)

	@handler CurrentMember
	get /members/me returns (Response)

	@handler LogoutMember
	post /members/logout returns (Response)
}

@server (
	group:  users
	prefix: /v1/rbac
)
service rbac-api {
	@handler ListUsers
	get /users (ListUsersRequest) returns (Response)

	@handler GetUser
	get /users/detail (GetUserRequest) returns (Response)

	@handler CreateUser
	post /users/create (CreateUserRequest) returns (Response)

	@handler UpdateUser
	post /users/update (UpdateUserRequest) returns (Response)

	@handler DeleteUser
	post /users/delete (DeleteUserRequest) returns (Response)

	@handler AssignRoles
	post /users/roles (AssignRolesRequest) returns (Response)
}

@server (
	group:  roles
	prefix: /v1/rbac
)
service rbac-api {
	@handler ListRoles
	get /roles (ListRolesRequest) returns (Response)

	@handler GetRole
	get /roles/detail (GetRoleRequest) returns (Response)

	@handler CreateRole
	post /roles/create (CreateRoleRequest) returns (Response)

	@handler UpdateRole
	post /roles/update (UpdateRoleRequest) returns (Response)

	@handler DeleteRole
	post /roles/delete (DeleteRoleRequest) returns (Response)

	@handler AssignMenus
	post /roles/menus (AssignMenusRequest) returns (Response)

	@handler RoleMenus
	get /roles/menus (RoleMenusRequest) returns (Response)
}

@server (
	group:  menus
	prefix: /v1/rbac
)
service rbac-api {
	@handler MenuList
	get /menus (SystemRequest) returns (Response)

	@handler MenuTree
	get /menus/tree (SystemRequest) returns (Response)

	@handler PublicMenus
	get /menus/public (SystemRequest) returns (Response)

	@handler GetMenu
	get /menus/detail (GetMenuRequest) returns (Response)

	@handler CreateMenu
	post /menus/create (CreateMenuRequest) returns (Response)

	@handler UpdateMenu
	post /menus/update (UpdateMenuRequest) returns (Response)

	@handler DeleteMenu
	post /menus/delete (DeleteMenuRequest) returns (Response)
}

@server (
	group:  systems
	prefix: /v1/rbac
)
service rbac-api {
	@handler ListSystems
	get /systems returns (Response)

	@handler SaveSystem
	post /systems/save (SaveSystemRequest) returns (Response)

	@handler DeleteSystem
	post /systems/delete (DeleteSystemRequest) returns (Response)
}

@server (
	group:  settings
	prefix: /v1/rbac
)
service rbac-api {
	@handler GetEmailSettings
	get /settings/email returns (Response)

	@handler SaveEmailSettings
	post /settings/email (SaveEmailSettingsRequest) returns (Response)
}

@server (
	group:  blacklist
	prefix: /v1/rbac
)
service rbac-api {
	@handler Blacklist
	get /blacklist returns (Response)

	@handler BlockIP
	post /blacklist/add (BlockIPRequest) returns (Response)

	@handler UnblockIP
	post /blacklist/delete (UnblockIPRequest) returns (Response)
}

