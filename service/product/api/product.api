syntax = "v1"

info (
	title: "product service"
)

import (
	"spec/content.api"
	"spec/manuals.api"
	"spec/releases.api"
)

type Response {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}

@server (
	group: health
)
service product-api {
	@handler Health
	get /health returns (Response)
}

