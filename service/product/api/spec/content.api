syntax = "v1"

type SaveContentRequest {
	Brand         WebsiteBrand          `json:"brand,optional"`
	Navigation    []WebsiteNavigation   `json:"navigation,optional"`
	Home          WebsiteHomeContent    `json:"home,optional"`
	Capabilities  []WebsiteCapability   `json:"capabilities,optional"`
	DeliverySteps []WebsiteDeliveryStep `json:"deliverySteps,optional"`
	Audiences     []WebsiteAudience     `json:"audiences,optional"`
	Product       WebsiteProductContent `json:"product,optional"`
	About         WebsiteAboutContent   `json:"about,optional"`
	Footer        WebsiteFooterContent  `json:"footer,optional"`
}

type WebsiteAboutContent {
	Title       string             `json:"title,optional"`
	Description string             `json:"description,optional"`
	IntroTitle  string             `json:"introTitle,optional"`
	Paragraphs  []string           `json:"paragraphs,optional"`
	Principles  []WebsitePrinciple `json:"principles,optional"`
	TeamTitle   string             `json:"teamTitle,optional"`
	TeamIntro   string             `json:"teamIntro,optional"`
	TeamRoles   []string           `json:"teamRoles,optional"`
}

type WebsiteAudience {
	Index       string `json:"index,optional"`
	Title       string `json:"title,optional"`
	Headline    string `json:"headline,optional"`
	Description string `json:"description,optional"`
}

type WebsiteBrand {
	Name         string `json:"name,optional"`
	FullName     string `json:"fullName,optional"`
	Description  string `json:"description,optional"`
	ContactEmail string `json:"contactEmail,optional"`
	RecordNumber string `json:"recordNumber,optional"`
	Copyright    string `json:"copyright,optional"`
}

type WebsiteCapability {
	Icon        string   `json:"icon,optional"`
	Key         string   `json:"key,optional"`
	Index       string   `json:"index,optional"`
	Title       string   `json:"title,optional"`
	Description string   `json:"description,optional"`
	Tags        []string `json:"tags,optional"`
}

type WebsiteDeliveryStep {
	Index       string `json:"index,optional"`
	Key         string `json:"key,optional"`
	Title       string `json:"title,optional"`
	Description string `json:"description,optional"`
}

type WebsiteFooterContent {
	Slogan    string `json:"slogan,optional"`
	Statement string `json:"statement,optional"`
}

type WebsiteHomeContent {
	ParticleShape       string   `json:"particleShape,default=artifact"`
	ParticleAutoplay    bool     `json:"particleAutoplay,default=true"`
	ParticleInteractive bool     `json:"particleInteractive,default=true"`
	Eyebrow             string   `json:"eyebrow,optional"`
	Title               string   `json:"title,optional"`
	Highlight           string   `json:"highlight,optional"`
	Description         string   `json:"description,optional"`
	PrimaryAction       string   `json:"primaryAction,optional"`
	SecondaryAction     string   `json:"secondaryAction,optional"`
	Meta                []string `json:"meta,optional"`
	CapabilityTitle     string   `json:"capabilityTitle,optional"`
	CapabilityIntro     string   `json:"capabilityIntro,optional"`
	FlowTitle           string   `json:"flowTitle,optional"`
	FlowIntro           string   `json:"flowIntro,optional"`
	AudienceTitle       string   `json:"audienceTitle,optional"`
	AudienceIntro       string   `json:"audienceIntro,optional"`
	BlogTitle           string   `json:"blogTitle,optional"`
	CTA                 string   `json:"cta,optional"`
}

type WebsiteNavigation {
	Label string `json:"label,optional"`
	Path  string `json:"path,optional"`
}

type WebsitePrinciple {
	Index       string `json:"index,optional"`
	Title       string `json:"title,optional"`
	Description string `json:"description,optional"`
}

type WebsiteProductContent {
	Title              string                     `json:"title,optional"`
	Description        string                     `json:"description,optional"`
	CapabilityTitle    string                     `json:"capabilityTitle,optional"`
	CapabilityIntro    string                     `json:"capabilityIntro,optional"`
	ArchitectureTitle  string                     `json:"architectureTitle,optional"`
	ArchitectureIntro  string                     `json:"architectureIntro,optional"`
	ArchitectureLayers []WebsiteArchitectureLayer `json:"architectureLayers,optional"`
	SecurityTitle      string                     `json:"securityTitle,optional"`
	SecurityIntro      string                     `json:"securityIntro,optional"`
	SecurityItems      []WebsiteSecurityItem      `json:"securityItems,optional"`
}

type WebsiteArchitectureLayer {
	Name  string   `json:"name,optional"`
	Items []string `json:"items,optional"`
}

type WebsiteSecurityItem {
	Title       string `json:"title,optional"`
	Description string `json:"description,optional"`
}

@server (
	group:  content
	prefix: /v1/product
)
service product-api {
	@handler Content
	get /content returns (Response)

	@handler SaveContent
	post /content (SaveContentRequest) returns (Response)
}

